FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY . .
RUN chmod +x mvnw && ./mvnw -B -q package -DskipTests -Dspotless.check.skip=true \
 && cp "$(ls target/ueberboese-api-*.jar | grep -v -- '-plain' | head -1)" /app.jar

FROM eclipse-temurin:25-jre
WORKDIR /workspace
RUN mkdir -p logs && chmod 777 logs
COPY --from=build /app.jar /app/app.jar
EXPOSE 8080 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]